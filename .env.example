# Copy to .env and fill in. .env is gitignored and is read only by the deploy
# scripts and by a local run; the container gets these as settings and secrets.

# A name used for the resource group, registry, environment and app.
# Lowercase letters and digits only; the registry name must be globally unique.
NAME=mcponazure
LOCATION=westeurope

# From the Entra app registration. Filled in by deploy/02-entra.sh.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# The container's public address, filled in by deploy/01-azure.sh.
PUBLIC_URL=
